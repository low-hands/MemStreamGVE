    def _dump_edit_mask_overlay(self, latent_block, mask_seq, block_start, debug_mask_dir, height, width):
        if not debug_mask_dir:
            return

        os.makedirs(debug_mask_dir, exist_ok=True)
        with torch.no_grad():
            mask = self._mask_reshape(
                mask_seq,
                size=(latent_block.shape[1], height, width),
                scale_factor=16,
            ).float()
            if mask.ndim == 4:
                mask = mask.unsqueeze(2)

            video = self.vae.decode_to_pixel(
                latent_block.to(next(self.vae.parameters()).device),
                use_cache=False,
            )
            video = video.detach().float().cpu()
            mask = mask.detach().float().cpu()

            frames = []
            for t in range(video.shape[1]):
                img = video[0, t].permute(1, 2, 0).clamp(0, 1)
                mask_t = min((t * mask.shape[1]) // max(video.shape[1], 1), mask.shape[1] - 1)
                m = mask[0, mask_t, 0].clamp(0, 1)

                if m.shape[-2:] != img.shape[:2]:
                    m = F.interpolate(
                        m[None, None],
                        size=img.shape[:2],
                        mode="nearest",
                    )[0, 0]

                overlay = img.clone()
                red = torch.zeros_like(img)
                red[..., 0] = 1.0
                overlay = overlay * (1 - 0.45 * m[..., None]) + red * (0.45 * m[..., None])

                frames.append((overlay.numpy() * 255).clip(0, 255).astype("uint8"))

            out_path = os.path.join(debug_mask_dir, f"block_{block_start:04d}_srcmask.mp4")
            iio.imwrite(out_path, frames, fps=16)

