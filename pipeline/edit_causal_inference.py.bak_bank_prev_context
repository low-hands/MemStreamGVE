            kv_bank[b_idx]["fg_mask_new"][:, :bank_mask.shape[1]] = bank_mask

    def _log_bank_alignment(self, kv_bank, block_start, log_path):
        if not log_path:
            return
        if not kv_bank or "block_ids" not in kv_bank[0]:
            return

        lines = []
        sample_layers = sorted(set([0, len(kv_bank) // 2, len(kv_bank) - 1]))
        for layer_idx in sample_layers:
            bank = kv_bank[layer_idx]
            block_ids = bank["block_ids"].detach()
            fg_mask = bank.get("fg_mask", None)
            if block_ids.shape[0] < 2:
                continue

            src_ids, trg_ids = block_ids.chunk(2, dim=0)
            valid = (src_ids >= 0) | (trg_ids >= 0)
            if valid.any():
                id_match = ((src_ids == trg_ids) & valid).float().sum() / valid.float().sum()
                id_match = id_match.item()
                src_unique = sorted(src_ids[src_ids >= 0].unique().detach().cpu().tolist())
                trg_unique = sorted(trg_ids[trg_ids >= 0].unique().detach().cpu().tolist())
            else:
                id_match = 1.0
                src_unique = []
                trg_unique = []

            if fg_mask is not None:
                src_fg, trg_fg = fg_mask.detach().chunk(2, dim=0)
                union = src_fg | trg_fg
                if union.any():
                    fg_iou = ((src_fg & trg_fg).float().sum() / union.float().sum()).item()
                else:
                    fg_iou = 1.0
            else:
                fg_iou = -1.0

            lines.append(
                f"[BANK_ALIGN] block={block_start} layer={layer_idx} "
                f"id_match={id_match:.4f} fg_iou={fg_iou:.4f} "
                f"src_blocks={src_unique} trg_blocks={trg_unique}\n"
            )

        if lines:
            with open(log_path, "a", encoding="utf-8") as f:
                f.writelines(lines)

