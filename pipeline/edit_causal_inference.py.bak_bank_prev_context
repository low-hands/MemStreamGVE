                "fg_mask_new": torch.zeros([batch_size, self.frame_seq_length], dtype=torch.bool, device=device),
                "block_ids": torch.full([batch_size, kv_bank_size], -1, dtype=torch.long, device=device),
                "block_ids_new": torch.full([batch_size, self.frame_seq_length], -1, dtype=torch.long, device=device),
